{
    "$schema": "https://schema.tauri.app/config/2",
    "productName": "VRCXF",
    "version": "0.1.0",
    "identifier": "com.aariyjp.vrcxf",
    "build": {
        "beforeDevCommand": "npm run dev-tauri",
        "beforeBuildCommand": "npm run prod-tauri",
        "devUrl": "http://localhost:9000",
        "frontendDist": "../build/html"
    },
    "app": {
        "withGlobalTauri": true,
        "windows": [
            {
                "label": "main",
                "title": "VRCXF",
                "width": 1280,
                "height": 800,
                "minWidth": 800,
                "minHeight": 500
            }
        ],
        "security": {
            "csp": null
        }
    },
    "bundle": {
        "active": true,
        "targets": "all",
        "icon": ["icons/icon.ico", "icons/icon.png"]
    }
}
